APP_MODE=mock
PORT=3000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Required only when APP_MODE=live
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Corpus embedding worker
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_LEASE_SECONDS=300
EMBEDDING_BASE_BACKOFF_SECONDS=30

# Optional conference discovery / crawl integration
TAVILY_API_KEY=
TAVILY_PROJECT=research-frontier-radar
